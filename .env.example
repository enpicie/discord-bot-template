# Environment variables the Lambdas read. In deployment these are INJECTED BY
# TERRAFORM (terraform/infra) — this file exists for reference and local testing
# only. Never commit a file with real values.

# ── Shared ───────────────────────────────────────────────────────────────────
REGION=                          # AWS region the Lambdas run in (e.g. us-east-2)
DISCORD_BOT_TOKEN_SECRET_NAME=   # Secrets Manager secret NAME holding the bot token (value fetched at runtime)  [feature:bot_token]
DYNAMODB_TABLE_NAME=             # DynamoDB table name (<app_name>-data-<env>)  [feature:dynamodb]

# ── Main bot Lambda (src/) ───────────────────────────────────────────────────
PUBLIC_KEY=                      # Discord application public key for interaction signature verification
DEFERRED_WORKER_QUEUE_URL=       # SQS queue URL for commands that cannot finish inside Discord's 3s deadline  [feature:deferred_worker]
